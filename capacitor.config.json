{
  "appId": "com.johmacos.secretary",
  "appName": "Secretary",
  "webDir": "dist",
  "server": {
    "url": "https://secretary-frontend.vercel.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "PASTE_YOUR_WEB_CLIENT_ID_HERE.apps.googleusercontent.com",
      "iosClientId": "PASTE_YOUR_NEW_IOS_CLIENT_ID_HERE.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    }
  }
}
